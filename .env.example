# Copy to .env. uv run --env-file .env whisper-studio
STUDIO_DATA=~/.local/share/whisper-studio
STUDIO_PORT=8765
STUDIO_HOSTNAME=transcribe.bernardyamoah.com
# Required before the production hostname will accept any request:
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
CF_ACCESS_EMAIL=
# Optional model mapping (restart required):
STUDIO_MODEL_FAST=base
STUDIO_MODEL_BALANCED=small
STUDIO_MODEL_ACCURATE=medium
